# Core (이미 설정됨)
OPENAI_API_KEY=sk-...
YOUTUBE_URLS=https://www.youtube.com/watch?v=dQw4w9WgXcQ


# Sources - 글로벌 기술 트렌드 중심
RSS_FEEDS=https://news.ycombinator.com/rss,https://ai.googleblog.com/atom.xml,https://openai.com/blog/rss.xml,https://blog.anthropic.com/rss.xml

# arXiv 설정 (더 넓은 범위)
ARXIV_SEARCH_QUERY=cat:cs.AI OR cat:cs.LG OR cat:cs.CL OR cat:cs.CV OR cat:cs.RO OR cat:cs.CR OR cat:cs.DC OR quant-ph

# Yozm (요즘IT) 스크래핑
USE_YOZM_SCRAPER=false

# Google News 검색어
GOOGLE_NEWS_QUERIES=AI,artificial intelligence,machine learning,GPT,LLM,quantum computing


# Reddit (선택사항)
REDDIT_CLIENT_ID=xxxx
REDDIT_CLIENT_SECRET=xxxx
REDDIT_USER_AGENT=ai-news-curator/0.1 by your_reddit_username
REDDIT_SUBREDDITS=MachineLearning,ArtificialIntelligence

# Notion (선택사항)
NOTION_INTEGRATION_SECRET=
NOTION_DATABASE_ID=

# Telegram (선택사항)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Output
OUTPUT_DIR=./output/notes
DAILY_NOTE_TITLE_PREFIX=AI-IT-Digest
TIMEZONE=Asia/Seoul
# AI 필터링 설정
MAX_FILTERED_ITEMS=20
# 병렬 처리 및 캐싱 설정
MAX_WORKERS=5
ENABLE_CACHE=true
CACHE_TTL_DAYS=7